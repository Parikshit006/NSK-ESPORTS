# ============================================================
# NSK ESPORTS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local dev, or add to your Vercel/Cloudflare project settings
# ============================================================

# 1. Supabase Project Configuration (From Supabase Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 2. Cloudinary Configuration (For tournament banners and media)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# 3. Admin Emails (Comma-separated list of emails with admin access)
VITE_ADMIN_EMAILS=parikshitpatil006@gmail.com,pkshit2006@gmail.com

# 4. Optional Production Domain URL
VITE_SITE_URL=https://your-production-domain.com
